  "narrative": {
    "northStar": "Dual Brand Marketplace",
    "overview": "OAGO EncendidorQTA es un marketplace B2B que alberga dos universos de marca — ER (rojo) y CIBAT (azul navy) — dentro de una sola arquitectura de catálogo. No es una tienda aspiracional; es un mostrador mayorista técnico y ordenado, pensado para reponer stock rápido. La interfaz prioriza densidad legible sobre teatralidad: grilla estricta, tarjetas verticales 4/4, precio en negro puro y badges por marca que funcionan como wayfinding.",
    "keyCharacteristics": [
      "Dualidad cromática como navegación (ER #a6282e/#cc0000 vs CIBAT #1b365d/#3d548f)",
      "Grilla catálogo 2 → 4 columnas, tarjetas rounded-2xl blancas sobre bg-gray-200 con imagen 4/4",
      "Tipografía sans black uppercase para títulos, precio text-lg font-black negro",
      "Elevación suave y funcional: sombras sólo para buscador/cards/drawer",
      "Motion mínimo: hover:scale-110 imagen, hover:brightness-110 CTA"
    ],
    "rules": [
      {
        "name": "The Two Inks Rule",
        "body": "Una tarjeta pertenece a CIBAT o ER, nunca a ambos. El brandColor tiñe badge + CTA + estado activo coherentemente.",
        "section": "colors"
      },
      {
        "name": "The Black Price Rule",
        "body": "El precio siempre es negro con tachado gris, nunca en color de marca.",
        "section": "colors"
      },
      {
        "name": "The Stone Navigation Rule",
        "body": "El centro piedra #cccccc es el único sólido del header; no agregar segundo color sólido.",
        "section": "colors"
      },
      {
        "name": "The Uppercase Wayfinding Rule",
        "body": "Todo lo que navega es uppercase bold con tracking; sólo la descripción es sentence case.",
        "section": "typography"
      },
      {
        "name": "The Price Is Black Rule",
        "body": "Precio nunca usa color de marca ni peso menor a 900.",
        "section": "typography"
      },
      {
        "name": "The Functional Lift Rule",
        "body": "Sombras sólo en respuesta a estado (hover, focus, sticky, drawer). En reposo, flat con border.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do usar brandColor coherente por producto (badge + CTA + tag activo comparten mismo #1b365d o #a6282e)",
      "Do mantener precio en negro text-lg font-black con tachado gris",
      "Do usar rounded-2xl en cards y rounded-full en todo lo filtrable",
      "Do elevar sólo buscador/cards/drawer con shadow-lg/xl; resto flat",
      "Do mantener títulos en uppercase font-black line-clamp-2 con hover:text por marca",
      "Do mostrar IMAGEN NO DISPONIBLE con brightness-0 opacity-20",
      "Do respetar View::prependLocation() — cambios visuales en themes/encendidorqta/"
    ],
    "donts": [
      "Don't pintar precio con color de marca",
      "Don't duplicar bg sólido en navbar más allá de piedra central",
      "Don't agregar toggle bulto/unidad sin re-hidratar ProductSearchService::hydratePrices()",
      "Don't usar Auth::user() — siempre current_user() para guard alt e impersonación",
      "Don't introducir serifas o fonts decorativas",
      "Don't usar sombras coloreadas o shadow-primary en storefront",
      "Don't crear nuevos offsets de color sin tonal ramp"
    ]
  }
